// Sprint-1 (milestone 0.1.0) target architecture. Hand-written, not
// `frob sys init` output (this file predates any generated skeleton).
// Companion to docs/design/sprint-1.md, which is the human-readable spec;
// this file is the checked model of the same design. `code=` globs are
// bound to PLANNED files (T-0006..T-0044) that do not all exist yet, so
// `frob check --only sys` running against this branch's code tree will
// show FOREIGN/missing-binding gaps until those tickets land -- expected
// during the design phase, not a defect in this file.

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
module hullbreach_sprint1

// -------------------------------------------------------------------
// External callers (foreign: outside our control once code ships to them)
// -------------------------------------------------------------------

// frob:ticket T-0095
node browser : foreign {
    // The React app runs inside a player's browser: our own JS, but
    // executing in an environment the player can inspect, tamper with,
    // or replay from -- untrusted the same way any client is.
    code "web/src/**";
    may "client_storage" via "web/src/auth/session.ts";
    may "fetch_url" via "web/src/api/auth.ts";
    waive "REL200:f_register" reason "T-0017 implemented the register form/fetch call (web/src/api/auth.ts::register) without a request timeout; T-0102 adds one and will declare/prove it there" ticket "T-0102";
    waive "REL200:f_login_web" reason "T-0021 implemented the login form/fetch call (web/src/api/auth.ts::login) without a request timeout; T-0102 adds one to every fetch call in that file and will declare/prove it there" ticket "T-0102";
    waive "REL200:f_logout" reason "T-0024 implemented the logout control's fetch call (web/src/api/auth.ts::logout) without a request timeout; T-0102 adds one to every fetch call in that file and will declare/prove it there" ticket "T-0102";
    waive "REL200:f_health" reason "design-only pass; no browser-side caller of /health exists yet -- T-0100 wires a web/ops caller for both /health and /ready" ticket "T-0100";
    waive "REL200:f_ready" reason "design-only pass; no browser-side caller of /ready exists yet -- T-0100 wires a web/ops caller for it" ticket "T-0100";
}

// frob:ticket T-0095
node game_client : foreign {
    // The Unity game client authenticates against us with a bearer
    // token obtained from /auth/login; we do not own or scan its code.
    managed;
    waive "REL200:f_login_game" reason "design-only pass; the game client is managed (no code we scan), and T-0026 lands the server-side session validation this flow leads to" ticket "T-0026";
}

// frob:ticket T-0095
node game_server : foreign {
    // The Unity game server validates a client-presented token via
    // GET /auth/session; lives in the sibling game repo (T-0026,
    // labeled needs-game), no scannable code here.
    managed;
    waive "REL200:f_session_check" reason "design-only pass; the game server is managed (no code we scan) and lives in the sibling repo; T-0026 lands the platform side of this flow" ticket "T-0026";
}

// -------------------------------------------------------------------
// Platform API, split by planned package (matches docs/design/sprint-1.md
// section 1's module map)
// -------------------------------------------------------------------

// frob:ticket T-0095
node hullbreach_server_root : trusted {
    code "src/hullbreach_server/__init__.py" "src/hullbreach_server/__main__.py";
    may "env.write" via "src/hullbreach_server/__main__.py::main";
    waive "REL200:database_url__issue" reason "design-only pass; the database URL is an operator-rotated credential (section 9's secret bound), not something T-0006's code path times out itself" ticket "T-0100";
    waive "REL200:database_url__revoke" reason "same as database_url__issue: rotation is operational, not a code-level timeout" ticket "T-0100";
    waive "REL200:f_database_url_to_db" reason "design-only pass; db/engine.py (T-0006) reads the URL once at engine construction, no request/response cycle to time out" ticket "T-0100";
}

// frob:ticket T-0095
node hullbreach_server_app : trusted {
    code "src/hullbreach_server/app/**";
    may "net.listen" via "src/hullbreach_server/app/app.py::App.__call__";
    may "env.read" via "src/hullbreach_server/app/config.py::AppConfig.from_external";
}

// frob:ticket T-0095
node hullbreach_server_api : trusted {
    code "src/hullbreach_server/api/**";
    waive "REL200:f_api_to_auth" reason "design-only pass; the internal api->auth call has no timeout token until T-0019/T-0020 land" ticket "T-0019";
    waive "REL200:f_api_to_db" reason "T-0012 landed the readiness check (check_connectivity via create_db_engine's 5s connect_timeout), but that is a connect_args kwarg, not a strata-declared flow timeout attr -- proving it formally is T-0100's follow-up work" ticket "T-0100";
}

// frob:ticket T-0095
node hullbreach_server_auth : trusted {
    code "src/hullbreach_server/auth/**";
    waive "REL200:f_auth_to_db" reason "design-only pass; the internal auth->db call has no timeout token until T-0019 lands" ticket "T-0019";
    waive "REL200:session_token__issue" reason "design-only pass; T-0019/T-0020 introduce auth/sessions.py, the real issuer, and will declare/prove a real timeout there" ticket "T-0019";
    waive "REL200:session_token__revoke" reason "same as session_token__issue: no auth/sessions.py code exists yet" ticket "T-0019";
    waive "REL200:password_hash__issue" reason "design-only pass; hash_password (T-0015) computes a hash in-process with no connection/request to time out; T-0016 is the real persistence call site and will declare/prove a real timeout there" ticket "T-0016";
    waive "REL200:password_hash__revoke" reason "same as password_hash__issue: a password hash is never revoked/rotated by code, only by a future rehash-on-login upgrade path (design section 8, open question)" ticket "T-0016";
    waive "REL200:f_session_token_to_browser" reason "design-only pass; T-0019/T-0020 introduce auth/sessions.py, which will declare/prove a real timeout on token issuance" ticket "T-0019";
    waive "REL200:f_session_token_to_game_client" reason "design-only pass; T-0026 introduces the game-client login path and will declare/prove a real timeout there" ticket "T-0026";
    waive "REL200:f_session_token_to_game_server" reason "design-only pass; T-0026 introduces GET /session and will declare/prove a real timeout there" ticket "T-0026";
    waive "REL200:f_password_hash_to_db" reason "design-only pass; hash_password (T-0015) has no request/response cycle to time out; T-0016 is the real persistence call site and will declare/prove a real timeout there" ticket "T-0016";
}

// frob:ticket T-0095
node hullbreach_server_db : trusted {
    code "src/hullbreach_server/db/**";
    may "sql" via "src/hullbreach_server/db/engine.py::check_connectivity";
    // users.email (contact) is account identity; users.password_hash
    // (credentials) is a credential at rest, never the raw password.
    // Both are covered by the data policy tracked in T-0049.
    carries "contact" "credentials";
    waive "REL200:f_db_to_postgres" reason "design-only pass; create_db_engine (T-0006) sets a 5s connect_timeout for the psycopg driver, but that is a connect_args kwarg, not a strata-declared flow timeout attr -- proving it formally is follow-up work, not blocking T-0006's own acceptance criteria" ticket "T-0100";
}

// frob:ticket T-0095
node hullbreach_server_logging : trusted {
    code "src/hullbreach_server/logging/**";
}

// -------------------------------------------------------------------
// Data store (external infrastructure, no code of ours to scan)
// -------------------------------------------------------------------

// frob:ticket T-0095
node hullbreach_postgres : trusted {
    managed;
}

// -------------------------------------------------------------------
// The test tree itself -- covers the capabilities pytest fixtures and
// build-smoke tests already legitimately exercise (subprocess/exec in
// tests/system/test_build.py's fresh-`uv sync` smoke test, tmp_path
// writes in tests/unit/test_app.py's config-file fixture).
// -------------------------------------------------------------------

// frob:ticket T-0095
// frob:ticket T-0097
// frob:doc docs/design/sprint-1.md#7-test-strategy
node tests : trusted {
    code "tests/**";
    code "web/tests/**";
    may "eval" via "tests/system/test_build.py";
    may "exec" via "tests/system/test_build.py";
    may "fs.read" via "tests/system/test_build.py";
    may "fs.write" via "tests/unit/test_app.py";
    may "client_storage" via "web/tests/unit/Header.test.tsx";
    may "client_storage" via "web/tests/unit/Login.test.tsx";
    may "sql"; // because: "sprint-1 xfail test bodies (test_seed.py, conftest.py) execute raw SQL against the in-memory SQLite fixture to assert idempotency/row counts; nearly every test in this node touches the database, so per-file via scoping is not worth it"
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#7-test-strategy
flow f_tests_to_root : tests -> hullbreach_server_root {
    label Internal;
    attr local;
    attr "test modules import hullbreach_server/__main__ directly";
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#7-test-strategy
flow f_tests_to_app : tests -> hullbreach_server_app {
    label Internal;
    attr local;
    attr "test modules import hullbreach_server.app directly";
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#7-test-strategy
flow f_tests_to_api : tests -> hullbreach_server_api {
    label Internal;
    attr local;
    attr "test modules import hullbreach_server.api.health directly";
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#7-test-strategy
flow f_tests_to_logging : tests -> hullbreach_server_logging {
    label Internal;
    attr local;
    attr "test modules import hullbreach_server.logging.* directly";
}

// frob:ticket T-0006
// frob:doc docs/design/sprint-1.md#7-test-strategy
flow f_tests_to_db : tests -> hullbreach_server_db {
    label Internal;
    attr local;
    attr "test modules import hullbreach_server.db/.db.engine directly";
}

// frob:ticket T-0015
// frob:doc docs/design/sprint-1.md#7-test-strategy
flow f_tests_to_auth : tests -> hullbreach_server_auth {
    label Internal;
    attr local;
    attr "test modules import hullbreach_server.auth.passwords directly";
}

