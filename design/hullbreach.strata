// -------------------------------------------------------------------
// Secrets: password hashes at rest, session tokens, and the database
// credential itself -- each modeled as a cache-of-authority per
// docs/strata/surface.md#std-secrets.
// -------------------------------------------------------------------

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
//
// `audience` is deliberately left empty (not `{ browser, game_client,
// game_server }`) on all three secrets below. `std.secrets` elaboration
// auto-generates one "reads" flow per audience member with its `src`
// set to the SYNTHETIC secret-clearance node -- and `secret_prop`'s
// grammar (issued_by/audience/lifetime/revoke) has no `waive` clause,
// unlike `node`/`store`, so those auto-generated flows can never
// discharge REL200 at this design-only stage (no code exists yet to
// carry the real timeout token). Filed as a language gap upstream:
// frob T-draft-deb011e5 ("strata: secret_prop reads-flows cannot carry a waive
// or timeout so REL200 is unfixable"). Worked around here by dropping
// `audience` and hand-declaring the equivalent "who reads/relies on
// this secret" edges as ordinary flows below, sourced from a REAL node
// that already has a `waive` slot -- at the cost of losing std.secrets'
// auto-generated `readers(secret) == audience` SetEquality claim for
// these three secrets, an accepted trade-off recorded here and in
// section 9 of the design doc.
secret session_token {
    issued_by hullbreach_server_auth;
    lifetime 14 d;
    revoke 1 s;
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
secret password_hash {
    issued_by hullbreach_server_auth;
    // Argon2id hashes are not time-bound the way a session token is;
    // the "lifetime" here stands for the rotation horizon at which a
    // scheme/parameter upgrade should be forced (open question, see
    // docs/design/sprint-1.md section 8 -- no rehash-on-login upgrade
    // path exists yet in 0.1.0).
    lifetime 3650 d;
    revoke 1 d;
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
secret database_url {
    issued_by hullbreach_server_root;
    // HULLBREACH_DATABASE_URL is an operator-rotated credential (env
    // var / secret manager), not something the app itself times out;
    // the bound recorded here is the operational rotation policy.
    lifetime 180 d;
    revoke 1 d;
}

// -------------------------------------------------------------------
// Hand-declared "who reads/relies on this secret" edges -- the manual
// equivalent of std.secrets' auto-generated reads flows (see the long
// comment above `secret session_token`), sourced from real nodes so
// REL200 can actually be waived, per the tickets that will implement
// each real timeout.
// -------------------------------------------------------------------

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
flow f_session_token_to_browser : hullbreach_server_auth -> browser {
    label Secret;
    attr "session token delivered to the web client on register/login";
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
flow f_session_token_to_game_client : hullbreach_server_auth -> game_client {
    label Secret;
    attr "session token delivered to the game client on login";
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
flow f_session_token_to_game_server : hullbreach_server_auth -> game_server {
    label Secret;
    attr "session token validity confirmed to the game server via GET /session";
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
flow f_password_hash_to_db : hullbreach_server_auth -> hullbreach_server_db {
    label Secret;
    attr "password hash persisted for future verification";
}

// frob:ticket T-0095
// frob:doc docs/design/sprint-1.md#9-strata-model-designhullbreachstrata
flow f_database_url_to_db : hullbreach_server_root -> hullbreach_server_db {
    label Secret;
    attr "database URL used by the engine to open connections";
}
