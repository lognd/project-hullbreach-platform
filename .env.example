# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# Every HULLBREACH_* key overrides [tool.hullbreach_server] in pyproject.toml.
HULLBREACH_HOST=127.0.0.1
HULLBREACH_PORT=8000
HULLBREACH_DATABASE_URL=postgresql://hullbreach:hullbreach@localhost:5432/hullbreach
# comma-separated
HULLBREACH_CORS_ORIGINS=http://localhost:5173

# seconds a login session stays valid before it must be re-issued (default 14 days)
HULLBREACH_SESSION_TTL_SECONDS=1209600

# docker-compose.yml reads these for the local PostgreSQL
POSTGRES_USER=hullbreach
POSTGRES_PASSWORD=hullbreach
POSTGRES_DB=hullbreach
