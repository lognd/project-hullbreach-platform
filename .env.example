# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# HULLBREACH_CONFIG=path/to/pyproject.toml names the config file explicitly;
# otherwise the nearest pyproject.toml above the cwd with a
# [tool.hullbreach_server] table is used.
# Every HULLBREACH_* key overrides [tool.hullbreach_server] in pyproject.toml.
HULLBREACH_HOST=127.0.0.1
HULLBREACH_PORT=8000
# Required: there is no built-in default. The password must match
# POSTGRES_PASSWORD below (replace both with your own value).
HULLBREACH_DATABASE_URL=postgresql://hullbreach:change-me-local-only@localhost:5432/hullbreach
# comma-separated
HULLBREACH_CORS_ORIGINS=http://localhost:5173

# seconds a login session stays valid before it must be re-issued (default 14 days)
HULLBREACH_SESSION_TTL_SECONDS=1209600

# failed-login rate limit: max attempts allowed within the window below
# before a 429, and the window's length in seconds (defaults: 5 / 60)
HULLBREACH_LOGIN_RATE_LIMIT_MAX=5
HULLBREACH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# docker-compose.yml reads these for the local PostgreSQL. POSTGRES_PASSWORD
# has no default: compose refuses to start until it is set. The database only
# listens on 127.0.0.1.
POSTGRES_USER=hullbreach
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=hullbreach

# Read directly by db/seed.py (`hullbreach_server db seed`); only used
# to create the FIRST admin account, if none exists yet. Never hard-code
# a real password here -- `db seed` fails rather than inventing one.
HULLBREACH_ADMIN_USERNAME=admin
HULLBREACH_ADMIN_EMAIL=admin@example.com
HULLBREACH_ADMIN_PASSWORD=changeme
